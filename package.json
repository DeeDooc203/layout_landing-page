{
  "name": "layout_landing-page",
  "version": "1.0.0",
  "description": "Landing page",
  "homepage": "http://layout_landing-page",
  "source": "index.html",
  "scripts": {
    "init": "mate-scripts init",
    "start": "parcel --open",
    "style-format": "npx stylelint 'src/**/*.scss' --fix --allow-empty-input",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{html,css,scss}'",
    "lint": "npm run style-format && npm run format && mate-scripts lint",
    "test:only": "mate-scripts test",
    "build": "parcel build --public-url=/dist/ ",
    "deploy": "mate-scripts deploy",
    "update": "mate-scripts update",
    "test": "npm run lint && npm run test:only"
  },
  "keywords": [],
  "author": "Mate Academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@linthtml/linthtml": "^0.10.2",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/jest-mochawesome-reporter": "^1.0.0",
    "@mate-academy/linthtml-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@mate-academy/stylelint-config": "latest",
    "@parcel/transformer-sass": "^2.16.4",
    "cypress": "^15.20.1",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^25.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "mocha": "^8.1.3",
    "mochawesome": "^8.0.1",

    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "parcel": "^2.16.4",
    "prettier": "^3.3.2",
    "sass": "^1.93.2",
    "stylelint": "^16.7.0",
    "stylelint-scss": "^6.4.1",
    "vite": "^6.3.6"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "mateAcademy": {
    "projectType": "layoutVite",
    "linters": {
      "javascript": false,
      "bem": false
    },
    "tests": {
      "jest": false,
      "backstop": false,
      "cypress": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeeDooc203/layout_landing-page.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DeeDooc203/layout_landing-page/issues"
